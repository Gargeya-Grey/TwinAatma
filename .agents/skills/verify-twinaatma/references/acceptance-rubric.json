      "mandatory": true,
      "critical": false,
      "checks": [
        "setup.cli_init",
        "setup.doctor"
      ]
    },
    {
      "id": "SETUP.artifact_install",
      "gate": "SETUP",
      "expected": "Each release artifact installs in isolation and initializes usable memory.",

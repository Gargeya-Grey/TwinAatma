# KnowledgeOS .gitignore

# OS files
Thumbs.db
.DS_Store

# Temporary
*.tmp
*.swp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Agent session permissions (machine-local command history)
.commandcode/

# Generated Codex server wiring contains machine-local absolute paths.
.codex/config.toml

# PyInstaller build output
build/
dist/
*.spec.bak
*.egg-info/
.eggs/

# Generated at wheel-build time by setup.py (do not commit)
knowledgeos/_assets/

# Local database (generated automatically via scripts)
knowledge_index.db
knowledge_index.db-*

# Autopilot runtime state (session briefs, timers)
.knowledgeos/

# Notion Environment variables / local keys
.env
*.env

# Personal / founder residue (never ship in toolkit)
Assets/papers/
pixel art.gif
*.pdf

# Runtime twin artifacts (generated by agents; not product source)
People/Self-Proposals/*.md
Inbox/*-MCP-smoke-capture.md
/Inbox/capture-*.md

# Local verification runs, reports, and task handoffs
/work/
/outputs/
